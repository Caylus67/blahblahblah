# Penguin Research Data Cleaning Tool
# Libraries
import seaborn as sns
import pandas as pd
import matplotlib.pyplot as plt

# Load the built-in Penguins dataset
penguins = sns.load_dataset("penguins")

# 1. Inspect dataset
print("First 5 rows:")
print(penguins.head())
print("\nMissing values count per column:")
print(penguins.isnull().sum())

# 2. Visualize missing values with a heatmap
plt.figure(figsize=(8, 5))
sns.heatmap(penguins.isnull(), cbar=False, cmap="viridis")
plt.title("Missing Values Heatmap")
plt.show()

# 3. Remove completely empty records
penguins_cleaned = penguins.dropna(how="all")

# 4. Fill missing categorical values (e.g., species, island, sex)
penguins_cleaned['species'] = penguins_cleaned['species'].fillna("Unknown")
penguins_cleaned['island'] = penguins_cleaned['island'].fillna("Unknown")
penguins_cleaned['sex'] = penguins_cleaned['sex'].fillna("Unknown")

# 5. Handle missing numerical values
# Interpolation
penguins_cleaned['bill_length_mm'] = penguins_cleaned['bill_length_mm'].interpolate()
penguins_cleaned['bill_depth_mm'] = penguins_cleaned['bill_depth_mm'].interpolate()
penguins_cleaned['flipper_length_mm'] = penguins_cleaned['flipper_length_mm'].interpolate()
penguins_cleaned['body_mass_g'] = penguins_cleaned['body_mass_g'].interpolate()

# Backward fill
penguins_cleaned['bill_length_mm'] = penguins_cleaned['bill_length_mm'].bfill()
penguins_cleaned['bill_depth_mm'] = penguins_cleaned['bill_depth_mm'].bfill()
penguins_cleaned['flipper_length_mm'] = penguins_cleaned['flipper_length_mm'].bfill()
penguins_cleaned['body_mass_g'] = penguins_cleaned['body_mass_g'].bfill()

# Forward fill
penguins_cleaned['bill_length_mm'] = penguins_cleaned['bill_length_mm'].ffill()
penguins_cleaned['bill_depth_mm'] = penguins_cleaned['bill_depth_mm'].ffill()
penguins_cleaned['flipper_length_mm'] = penguins_cleaned['flipper_length_mm'].ffill()
penguins_cleaned['body_mass_g'] = penguins_cleaned['body_mass_g'].ffill()

# 6. Final check
print("\nMissing values after cleaning:")
print(penguins_cleaned.isnull().sum())

# Save cleaned dataset
penguins_cleaned.to_csv("penguins_cleaned.csv", index=False)
print("\nCleaned dataset saved as penguins_cleaned.csv")
